<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Поймай квадрат v1.1.4</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    display: flex; flex-direction: column; align-items: center;
    justify-content: center; min-height: 100vh;
    background: #1a1a2e; color: #fff;
    font-family: system-ui, sans-serif; user-select: none;
    padding: 16px;
  }
  h1 { font-size: 20px; margin-bottom: 2px; font-weight: 600; }
  #version { font-size: 11px; color: #4ade80; margin-bottom: 10px; letter-spacing: 1px; opacity: 0.8; }
  #stats {
    display: flex; gap: 12px; margin-bottom: 10px;
    font-size: 14px; color: #aaa; flex-wrap: wrap;
    justify-content: center; align-items: center;
  }
  #stats b { color: #4ade80; }
  #lives { color: #ef4444; letter-spacing: 2px; font-size: 15px; }
  #combo { color: #facc15; font-weight: bold; min-width: 60px; text-align: center; }
  #timer {
    width: 320px; max-width: 100%; height: 6px; background: #16213e;
    border-radius: 3px; margin-bottom: 12px; overflow: hidden;
  }
  #timerFill { height: 100%; width: 100%; background: #4ade80; transition: width 0.1s linear; }
  #game {
    position: relative; width: 320px; height: 320px; max-width: 100%;
    background: #16213e; border-radius: 12px;
    overflow: hidden; cursor: crosshair;
    box-shadow: 0 0 30px rgba(74, 222, 128, 0.15);
    transition: box-shadow 0.2s;
  }
  #game.frozen { box-shadow: 0 0 40px rgba(96, 165, 250, 0.6); cursor: not-allowed; }
  #freezeBadge {
    position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
    background: rgba(96, 165, 250, 0.9); color: #fff;
    padding: 4px 12px; border-radius: 12px;
    font-size: 12px; font-weight: bold;
    pointer-events: none; opacity: 0; transition: opacity 0.2s; z-index: 5;
  }
  #game.frozen #freezeBadge { opacity: 1; }
  .obj {
    position: absolute; width: 50px; height: 50px;
    border-radius: 10px; cursor: pointer;
    transition: transform 0.06s, filter 0.25s;
  }
  .obj:active { transform: scale(0.85); }
  .obj.normal { background: linear-gradient(135deg, #4ade80, #22c55e); box-shadow: 0 0 20px rgba(74, 222, 128, 0.5); }
  .obj.gold { background: linear-gradient(135deg, #facc15, #f59e0b); box-shadow: 0 0 25px rgba(250, 204, 21, 0.7); }
  .obj.bomb { background: radial-gradient(circle at 30% 30%, #555, #111); box-shadow: 0 0 25px rgba(239, 68, 68, 0.8); border: 2px solid #ef4444; }
  .obj.freeze { background: linear-gradient(135deg, #60a5fa, #3b82f6); box-shadow: 0 0 25px rgba(96, 165, 250, 0.8); }
  #game.frozen .obj { filter: brightness(0.7); }
  .popup {
    position: absolute; pointer-events: none;
    font-weight: bold; font-size: 16px;
    animation: rise 0.7s ease-out forwards;
    text-shadow: 0 0 8px rgba(0,0,0,0.8); z-index: 6;
  }
  @keyframes rise {
    from { opacity: 1; transform: translateY(0); }
    to { opacity: 0; transform: translateY(-40px); }
  }
  #overlay {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.9);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 12px; z-index: 10; text-align: center; padding: 18px;
  }
  #overlay.hidden { display: none; }
  #overlay h2 { font-size: 22px; }
  #overlay p { color: #aaa; font-size: 12.5px; max-width: 270px; line-height: 1.5; }
  .legend {
    display: flex; gap: 10px; font-size: 11px; color: #888;
    flex-wrap: wrap; justify-content: center; max-width: 280px;
  }
  .legend span::before {
    content: ''; display: inline-block; width: 10px; height: 10px;
    border-radius: 3px; margin-right: 4px; vertical-align: middle;
  }
  .legend .l-green::before { background: #4ade80; }
  .legend .l-gold::before { background: #facc15; }
  .legend .l-bomb::before { background: #ef4444; }
  .legend .l-freeze::before { background: #60a5fa; }
  .levels { display: flex; gap: 6px; flex-wrap: wrap; justify-content: center; }
  .levels button {
    padding: 7px 12px; font-size: 12px; font-weight: 600;
    background: #16213e; color: #fff; border: 1px solid #4ade80;
    border-radius: 8px; cursor: pointer;
  }
  .levels button.active { background: #4ade80; color: #1a1a2e; }
  #startBtn {
    padding: 12px 28px; font-size: 16px; font-weight: bold;
    background: #4ade80; color: #1a1a2e; border: none;
    border-radius: 8px; cursor: pointer; margin-top: 4px;
  }
  #startBtn:hover { background: #22c55e; }
  .linkBtn {
    background: transparent; color: #4ade80; border: 1px solid #4ade80;
    padding: 6px 14px; border-radius: 6px; font-size: 12px; cursor: pointer;
  }
  .linkBtn:hover { background: rgba(74, 222, 128, 0.1); }
  .tgBtn {
    display: inline-block; text-decoration: none;
    background: #229ED9; color: #fff; border: none;
    padding: 8px 18px; border-radius: 6px; font-size: 13px;
    font-weight: 600; cursor: pointer; margin-top: 2px;
    transition: background 0.15s;
  }
  .tgBtn:hover { background: #1d8ec2; }
  #board {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.95);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px; z-index: 20; text-align: center; padding: 18px;
  }
  #board.hidden { display: none; }
  #board h2 { font-size: 20px; margin-bottom: 4px; }
  #boardList { list-style: none; width: 220px; }
  #boardList li {
    display: flex; justify-content: space-between;
    padding: 6px 10px; font-size: 14px;
    border-bottom: 1px solid #222; color: #ccc;
  }
  #boardList li.top1 { color: #facc15; font-weight: bold; }
  #boardList li span:first-child { color: #666; margin-right: 8px; }
  #boardList li .empty { color: #444; }
  #changelog {
    position: absolute; inset: 0;
    background: rgba(0,0,0,0.95);
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px; z-index: 20; text-align: center; padding: 16px;
  }
  #changelog.hidden { display: none; }
  #changelog h2 { font-size: 18px; margin-bottom: 4px; }
  #changelogList {
    width: 260px; max-height: 220px; overflow-y: auto;
    text-align: left; font-size: 11.5px; line-height: 1.5;
    color: #ccc; padding-right: 6px;
  }
  #changelogList .ver {
    color: #4ade80; font-weight: bold; font-size: 12.5px;
    margin-top: 8px; margin-bottom: 2px;
  }
  #changelogList .ver:first-child { margin-top: 0; }
  #changelogList .item { color: #aaa; padding-left: 10px; }
  #changelogList .item::before { content: '• '; color: #666; }
  #changelogList::-webkit-scrollbar { width: 4px; }
  #changelogList::-webkit-scrollbar-thumb { background: #4ade80; border-radius: 2px; }
</style>
</head>
<body>
  <h1>Поймай квадрат</h1>
  <div id="version">версия 1.1.4</div>
  <div id="stats">
    <div>Очки: <b id="score">0</b></div>
    <div>Рекорд: <b id="best">0</b></div>
    <div id="lives">❤❤❤</div>
    <div id="combo"></div>
  </div>
  <div id="timer"><div id="timerFill"></div></div>
  <div id="game">
    <div id="freezeBadge">Заморозка — клики заблокированы</div>
    <div id="board" class="hidden">
      <h2>Таблица рекордов</h2>
      <ul id="boardList"></ul>
      <button class="linkBtn" id="closeBoard">Закрыть</button>
    </div>
    <div id="changelog" class="hidden">
      <h2>Что исправлено</h2>
      <div id="changelogList"></div>
      <button class="linkBtn" id="closeChangelog">Закрыть</button>
    </div>
    <div id="overlay">
      <h2>Готов?</h2>
      <p>Лови квадраты, избегай бомб. У тебя 3 жизни.</p>
      <div class="legend">
        <span class="l-green">+очки</span>
        <span class="l-gold">x3 очка</span>
        <span class="l-bomb">−жизнь</span>
        <span class="l-freeze">заморозка 3с</span>
      </div>
      <div class="levels">
        <button data-speed="1300" data-time="30">Легко</button>
        <button data-speed="900" data-time="30" class="active">Норма</button>
        <button data-speed="600" data-time="25">Сложно</button>
      </div>
      <button id="startBtn">Начать игру</button>
      <button class="linkBtn" id="showBoard">Таблица рекордов</button>
      <button class="linkBtn" id="showChangelog">Что исправлено</button>
      <a class="tgBtn" href="https://t.me/Poimait" target="_blank" rel="noopener">Наш Telegram-канал</a>
    </div>
  </div>

<script>
/*
 * Поймай квадрат — Changelog
 * v1.1.4 — кнопка Telegram-канала
 * v1.1.3 — кнопка «Что исправлено»
 * v1.1.2 — hotfix: 6 багов заморозки + синхронизация best + топ-5 за 0
 * v1.1.1 — hotfix: дубликаты в таблице, ложное «топ-5»
 * v1.1.0 — таблица рекордов (топ-5)
 * v1.0.1 — hotfix: combo exploit, stale target, bomb freeze
 * v1.0.0 — first stable release
 */
"use strict";
const GAME_VERSION = "1.1.4";
const BOARD_KEY = "leaderboard_v1";
const NEXT_ID_KEY = "lb_next_id";

const game = document.getElementById('game');
const overlay = document.getElementById('overlay');
const board = document.getElementById('board');
const boardList = document.getElementById('boardList');
const changelog = document.getElementById('changelog');
const changelogList = document.getElementById('changelogList');
const startBtn = document.getElementById('startBtn');
const showBoardBtn = document.getElementById('showBoard');
const closeBoardBtn = document.getElementById('closeBoard');
const showChangelogBtn = document.getElementById('showChangelog');
const closeChangelogBtn = document.getElementById('closeChangelog');
const scoreEl = document.getElementById('score');
const bestEl = document.getElementById('best');
const comboEl = document.getElementById('combo');
const livesEl = document.getElementById('lives');
const timerFill = document.getElementById('timerFill');
const levelBtns = document.querySelectorAll('.levels button');

let score = 0, timeLeft = 30, totalTime = 30;
let playing = false, combo = 0, lives = 3;
let speed = 900;
let hideTimer = null, tickTimer = null, freezeTimer = null;
let frozen = false;
let ended = false;
let current = null;
let levelName = "Норма";

let best = localStorage.getItem('bestScore') || 0;
bestEl.textContent = best;

const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
function beep(freq, dur = 0.08, type = 'sine', vol = 0.15) {
  try {
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = type;
    osc.frequency.value = freq;
    gain.gain.setValueAtTime(vol, audioCtx.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
    osc.connect(gain).connect(audioCtx.destination);
    osc.start();
    osc.stop(audioCtx.currentTime + dur);
  } catch (e) {}
}

function pickType() {
  const r = Math.random();
  if (r < 0.60) return 'normal';
  if (r < 0.75) return 'gold';
  if (r < 0.93) return 'bomb';
  return 'freeze';
}

function spawn() {
  if (current) { current.el.remove(); current = null; }
  if (!playing) return;

  const w = game.clientWidth || 320;
  const h = game.clientHeight || 320;
  const maxX = Math.max(0, w - 50);
  const maxY = Math.max(0, h - 50);

  const el = document.createElement('div');
  const type = pickType();
  el.className = 'obj ' + type;
  el.style.left = Math.random() * maxX + 'px';
  el.style.top = Math.random() * maxY + 'px';
  game.appendChild(el);

  const obj = { el, type };
  current = obj;

  el.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!playing || current !== obj) return;
    handleHit(obj, e);
  });

  scheduleHide();
}

function scheduleHide() {
  clearTimeout(hideTimer);
  if (!playing || frozen) return;
  hideTimer = setTimeout(() => {
    if (!playing || frozen) return;
    if (current && current.type !== 'gold') {
      combo = 0;
      updateCombo();
    }
    spawn();
  }, speed);
}

function handleHit(obj, e) {
  const rect = game.getBoundingClientRect();
  const px = e.clientX - rect.left - 10;
  const py = e.clientY - rect.top - 20;

  if (frozen) {
    showPopup(px, py, obj.type === 'freeze' ? 'уже активно' : 'заморозка', '#60a5fa');
    if (obj.type !== 'bomb' && obj.type !== 'freeze') {
      if (current) { current.el.remove(); current = null; }
    }
    return;
  }

  if (obj.type === 'bomb') {
    lives--;
    updateLives();
    beep(120, 0.25, 'sawtooth', 0.25);
    showPopup(px, py, '-жизнь', '#ef4444');
    combo = 0;
    updateCombo();
    if (lives <= 0) { endGame(); return; }
  } else if (obj.type === 'freeze') {
    activateFreeze();
    showPopup(px, py, 'заморозка', '#60a5fa');
    beep(1200, 0.15, 'sine');
  } else {
    const gold = obj.type === 'gold';
    combo++;
    const mult = Math.min(Math.floor(combo / 3) + 1, 5);
    const points = (gold ? 3 : 1) * mult;
    score += points;
    scoreEl.textContent = score;
    updateCombo();
    showPopup(px, py, '+' + points, gold ? '#facc15' : '#4ade80');
    beep(gold ? 880 : 660, 0.07);
  }

  spawn();
}

function activateFreeze() {
  frozen = true;
  clearTimeout(hideTimer);
  clearTimeout(freezeTimer);
  clearInterval(tickTimer);
  game.classList.add('frozen');
  freezeTimer = setTimeout(() => {
    frozen = false;
    game.classList.remove('frozen');
    resumeTimer();
    spawn();
  }, 3000);
}

function resumeTimer() {
  clearInterval(tickTimer);
  tickTimer = setInterval(() => {
    if (!playing || frozen) return;
    timeLeft -= 0.1;
    timerFill.style.width = Math.max(0, timeLeft / totalTime * 100) + '%';
    if (timeLeft <= 0) endGame();
  }, 100);
}

function showPopup(x, y, text, color = '#facc15') {
  const p = document.createElement('div');
  p.className = 'popup';
  p.textContent = text;
  p.style.left = x + 'px';
  p.style.top = y + 'px';
  p.style.color = color;
  game.appendChild(p);
  setTimeout(() => p.remove(), 700);
}

function updateCombo() {
  comboEl.textContent = combo > 1 ? 'x' + Math.min(combo, 5) : '';
}

function updateLives() {
  livesEl.textContent = '❤'.repeat(Math.max(0, lives)) + '♡'.repeat(Math.max(0, 3 - lives));
}

game.addEventListener('click', () => {
  if (!playing) return;
  combo = 0;
  updateCombo();
  beep(200, 0.05, 'square', 0.08);
});

levelBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    levelBtns.forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    speed = +btn.dataset.speed;
    totalTime = +btn.dataset.time;
    levelName = btn.textContent.trim();
  });
});

/* ─── Таблица рекордов ─── */
function loadBoard() {
  try {
    const raw = localStorage.getItem(BOARD_KEY);
    const arr = JSON.parse(raw);
    return Array.isArray(arr) ? arr.filter(e => e && typeof e.score === 'number') : [];
  } catch (e) { return []; }
}

function nextId() {
  const id = +(localStorage.getItem(NEXT_ID_KEY) || 1);
  localStorage.setItem(NEXT_ID_KEY, id + 1);
  return id;
}

function saveToBoard(entry) {
  if (!entry || entry.score <= 0) {
    return { top: loadBoard(), inTop: false };
  }
  const list = loadBoard();
  entry.id = nextId();
  entry.date = Date.now();
  list.push(entry);
  list.sort((a, b) => b.score - a.score);
  const top = list.slice(0, 5);
  localStorage.setItem(BOARD_KEY, JSON.stringify(top));
  const inTop = top.some(e => e.id === entry.id);
  return { top, inTop };
}

function renderBoard() {
  const list = loadBoard();
  boardList.innerHTML = '';
  if (list.length === 0) {
    const li = document.createElement('li');
    li.innerHTML = '<span class="empty">Пока пусто</span>';
    boardList.appendChild(li);
    return;
  }
  list.forEach((entry, i) => {
    const li = document.createElement('li');
    if (i === 0) li.classList.add('top1');
    li.innerHTML = `<span>${i + 1}.</span><span>${entry.score} очк. · ${entry.level}</span>`;
    boardList.appendChild(li);
  });
}

showBoardBtn.addEventListener('click', () => {
  renderBoard();
  board.classList.remove('hidden');
});

closeBoardBtn.addEventListener('click', () => {
  board.classList.add('hidden');
});

/* ─── Changelog ─── */
const CHANGELOG = [
  {
    ver: "1.1.4",
    items: [
      "кнопка с ссылкой на Telegram-канал"
    ]
  },
  {
    ver: "1.1.3",
    items: [
      "кнопка «Что исправлено» с историей версий"
    ]
  },
  {
    ver: "1.1.2",
    items: [
      "заморозка больше не съедает 3 сек игрового времени",
      "клик по бомбе во время заморозки не убирает её (был эксплойт)",
      "клик по цели во время заморозки не спавнит новые (был спам)",
      "клик по freeze убирает «протухшую» цель",
      "после заморозки новая цель появляется сразу, без задержки",
      "рекорд синхронизируется с таблицей при загрузке",
      "«Попадание в топ-5» больше не показывается за 0 очков",
      "уникальный id вместо date+random — убраны дубликаты",
      "плавное тускнение объектов при заморозке"
    ]
  },
  {
    ver: "1.1.1",
    items: [
      "убрано ложное «Попадание в топ-5» при совпадении очков",
      "флаг inTop возвращается из saveToBoard и проверяется по id"
    ]
  },
  {
    ver: "1.1.0",
    items: [
      "таблица рекордов (топ-5)"
    ]
  },
  {
    ver: "1.0.1",
    items: [
      "эксплойт множителя — комбо держалось x5 вечно",
      "«протухшая» цель после заморозки",
      "бомба не убиралась при клике во время заморозки"
    ]
  },
  {
    ver: "1.0.0",
    items: [
      "первый стабильный релиз"
    ]
  }
];

function renderChangelog() {
  changelogList.innerHTML = '';
  CHANGELOG.forEach(block => {
    const ver = document.createElement('div');
    ver.className = 'ver';
    ver.textContent = 'v' + block.ver;
    changelogList.appendChild(ver);
    block.items.forEach(text => {
      const item = document.createElement('div');
      item.className = 'item';
      item.textContent = text;
      changelogList.appendChild(item);
    });
  });
}

showChangelogBtn.addEventListener('click', () => {
  renderChangelog();
  changelog.classList.remove('hidden');
});

closeChangelogBtn.addEventListener('click', () => {
  changelog.classList.add('hidden');
});

/* ─── Игра ─── */
function startGame() {
  clearTimeout(hideTimer);
  clearTimeout(freezeTimer);
  clearInterval(tickTimer);
  if (current) { current.el.remove(); current = null; }

  score = 0; combo = 0; lives = 3;
  timeLeft = totalTime;
  playing = true; frozen = false; ended = false;
  game.classList.remove('frozen');
  scoreEl.textContent = 0;
  updateCombo();
  updateLives();
  timerFill.style.width = '100%';
  overlay.classList.add('hidden');
  board.classList.add('hidden');
  changelog.classList.add('hidden');

  if (audioCtx.state === 'suspended') audioCtx.resume();

  spawn();
  resumeTimer();
}

function endGame() {
  if (ended) return;
  ended = true;
  playing = false;

  clearTimeout(hideTimer);
  clearTimeout(freezeTimer);
  clearInterval(tickTimer);
  game.classList.remove('frozen');
  if (current) { current.el.remove(); current = null; }

  if (score > best) {
    best = score;
    localStorage.setItem('bestScore', best);
    bestEl.textContent = best;
  }

  const { inTop } = saveToBoard({ score, level: levelName });

  beep(440, 0.15);
  setTimeout(() => beep(330, 0.25), 150);

  const dead = lives <= 0;
  overlay.querySelector('h2').textContent = dead ? 'Жизни кончились' : 'Время вышло!';
  overlay.querySelector('p').textContent =
    `Очки: ${score}. Рекорд: ${best}.` + (inTop ? ' Попадание в топ-5!' : '');
  startBtn.textContent = 'Играть снова';
  overlay.classList.remove('hidden');
}

(function syncBest() {
  const list = loadBoard();
  const maxInBoard = list.length ? list[0].score : 0;
  if (maxInBoard > best) {
    best = maxInBoard;
    localStorage.setItem('bestScore', best);
    bestEl.textContent = best;
  }
})();

startBtn.addEventListener('click', startGame);

console.log(`Поймай квадрат — v${GAME_VERSION} загружена`);
console.log('Changelog: v1.1.4 — кнопка Telegram-канала');
</script>
</body>
</html>
